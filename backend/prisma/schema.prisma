// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AUTHENTICATION SCHEMAS
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  courses Course[]
  events  Event[]
  tasks   Task[]
}

model PendingUser {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String?
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// COURSE SCHEMAS
enum CourseType {
  CUSTOM
  NUS
}

model Course {
  courseId    String     @id @default(uuid()) @db.Uuid
  courseCode  String?
  courseTitle String
  courseType  CourseType
  createdAt   DateTime   @default(now())
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id])

  folders Folder[]
  events  Event[]
  tasks   Task[]

  @@unique([userId, courseCode])
}

model Folder {
  folderId    String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  course      Course   @relation(fields: [courseId], references: [courseId], onDelete: Cascade)
  name        String
  description String
  createdAt   DateTime @default(now())

  links Link[]

  @@unique([courseId, name])
}

model Link {
  linkId    String   @id @default(uuid()) @db.Uuid
  folderId  String   @db.Uuid
  folder    Folder   @relation(fields: [folderId], references: [folderId], onDelete: Cascade)
  title     String
  url       String
  createdAt DateTime @default(now())

  @@unique([folderId, title])
}

enum EventType {
  CLASS
  DEADLINE
  EXAM
  OTHERS
}

model Event {
  eventId   String    @id @default(uuid()) @db.Uuid
  eventType EventType
  courseId  String?   @db.Uuid
  course    Course?   @relation(fields: [courseId], references: [courseId], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User?     @relation(fields: [userId], references: [id])
  title     String
  week      String
  day       String
  startTime String
  endTime   String?
  venue     String?
}

enum TaskType {
  WEEKLY
  TODAY
}

model Task {
  taskId    String   @id @default(uuid()) @db.Uuid
  name      String
  taskType  TaskType
  createdAt DateTime @default(now())
  completed Boolean  @default(false)
  courseId  String?  @db.Uuid
  course    Course?  @relation(fields: [courseId], references: [courseId], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
}
